{% comment %}
  Overrides the theme's feature_row: the title is the link (stretched over the whole card in
  assets/css/main.scss), and a button is only shown when an item sets btn_label.
{% endcomment %}
{% assign locale = include.locale | default: site.locale %}
{% if include.id %}
  {% assign feature_row = page[include.id] %}
{% else %}
  {% assign feature_row = page.feature_row %}
{% endif %}

<div class="feature__wrapper">

  {% for f in feature_row %}
    <div class="feature__item{% if include.type %}--{{ include.type }}{% endif %}">
      <div class="archive__item{% if f.url %} feature-card{% endif %}">
        {% if f.image_path %}
          <div class="archive__item-teaser">
            <img src="{{ f.image_path | relative_url }}"
                 alt="{% if f.alt %}{{ f.alt }}{% endif %}">
            {% if f.image_caption %}
              <span class="archive__item-caption">{{ f.image_caption | markdownify | remove: "<p>" | remove: "</p>" }}</span>
            {% endif %}
          </div>
        {% endif %}

        <div class="archive__item-body">
          {% if f.title %}
            <h2 class="archive__item-title">{% if f.url %}<a href="{{ f.url | relative_url }}" class="feature-card__link">{{ f.title }}</a>{% else %}{{ f.title }}{% endif %}</h2>
          {% endif %}

          {% if f.excerpt %}
            <div class="archive__item-excerpt">
              {{ f.excerpt | markdownify }}
            </div>
          {% endif %}

          {% if f.url and f.btn_label %}
            <p><a href="{{ f.url | relative_url }}" class="btn {{ f.btn_class }}">{{ f.btn_label }}</a></p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}

</div>
